# Supabase (publishable key — se usa en cliente y servidor)
SUPABASE_PROJECT_ID="tu-project-id"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxxx"
SUPABASE_URL="https://tu-proyecto.supabase.co"

# Supabase service role key (SECRETA — solo servidor, nunca exponer).
# Es la que usan las server functions para leer/escribir las corridas.
# Panel: Supabase → Settings → API → Project API keys → service_role
SUPABASE_SERVICE_ROLE_KEY="sb_secret_xxxx"
VITE_SUPABASE_PROJECT_ID="tu-project-id"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxxx"
VITE_SUPABASE_URL="https://tu-proyecto.supabase.co"

# ── IA gratuita (razonamiento + imágenes) ──────────────────────────────────
# Razonamiento: Pollinations.ai (text.pollinations.ai) — proveedor principal,
# sin API key ni límites. Fallback a Ollama local. Si ninguno está disponible,
# un generador determinístico garantiza el output (nunca falla).
# Las imágenes del storyboard usan Pollinations.ai — NO requiere API key.

# ──────────────────────────────────────────────────────────────────────────────
# Video (OPCIONAL): solo Google Veo con GEMINI_API_KEY. Sin clave, el render
# gratuito con ffmpeg toma el relevo.
GEMINI_API_KEY=""

# ──────────────────────────────────────────────────────────────────────────────
# Secreto para el webhook del scheduler externo (n8n) — POST /api/public/hooks/produce
SCHEDULER_HOOK_SECRET="un-secreto-largo-y-aleatorio"
