# Supabase (publishable key — se usa en cliente y servidor)
SUPABASE_PROJECT_ID="tu-project-id"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxxx"
SUPABASE_URL="https://tu-proyecto.supabase.co"
VITE_SUPABASE_PROJECT_ID="tu-project-id"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxxx"
VITE_SUPABASE_URL="https://tu-proyecto.supabase.co"

# IA gratuita con Google Gemini (obtener en https://aistudio.google.com/apikey)
GEMINI_API_KEY="tu-clave-gemini"

# Sensado de tendencias de YouTube (https://console.cloud.google.com/apis)
YOUTUBE_API_KEY="tu-clave-youtube-data-api"

# Secreto para el webhook del scheduler externo (n8n) — POST /api/public/hooks/produce
SCHEDULER_HOOK_SECRET="un-secreto-largo-y-aleatorio"
